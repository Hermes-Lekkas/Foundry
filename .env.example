# === The Foundry — Environment Configuration ===

# API Keys (for Teacher model / external judge)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Server
FOUNDRY_HOST=0.0.0.0
FOUNDRY_PORT=8420
FOUNDRY_LOG_LEVEL=info

# Hardware overrides (auto-detected if unset)
# FOUNDRY_DEVICE=cuda
# FOUNDRY_VRAM_LIMIT_GB=24

# Training defaults
FOUNDRY_DEFAULT_MODEL=unsloth/Qwen2.5-0.5B
FOUNDRY_CHECKPOINT_DIR=./checkpoints
FOUNDRY_DATASET_DIR=./datasets

# Sandbox
FOUNDRY_SANDBOX_TIMEOUT=30
FOUNDRY_SANDBOX_USE_DOCKER=false

# Data synthesis
FOUNDRY_TEACHER_PROVIDER=anthropic
FOUNDRY_TEACHER_MODEL=claude-sonnet-4-5-20250929
